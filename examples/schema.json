{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "parties": {
      "type": "object",
      "properties": {
        "landlord_name": { "type": ["string", "null"] },
        "tenant_name": { "type": ["string", "null"] }
      },
      "required": ["landlord_name", "tenant_name"],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "unit_address": { "type": ["string", "null"] },
        "unit_postcode": { "type": ["string", "null"] }
      },
      "required": ["unit_address", "unit_postcode"],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "properties": {
        "lease_start_date": { "type": ["string", "null"], "format": "date" },
        "lease_end_date": { "type": ["string", "null"], "format": "date" },
        "annual_rent": { "type": ["number", "null"] },
        "has_break_clause": { "type": ["boolean", "null"] }
      },
      "required": ["lease_start_date", "lease_end_date", "annual_rent", "has_break_clause"],
      "additionalProperties": false
    }
  },
  "required": ["parties", "unit", "lease"],
  "additionalProperties": false
}
